{
  "models": [
    {
      "id": "page-metadata",
      "fields": [
        {
          "component": "text",
          "valueType": "string",
          "name": "jcr:title",
          "label": "Title"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "jcr:description",
          "label": "Description"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "keywords",
          "multi": true,
          "label": "Keywords"
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "category",
          "label": "Recipe Category",
          "description": "Recipe pages only: the category the recipe is listed under",
          "options": [
            {
              "name": "None",
              "value": ""
            },
            {
              "name": "Appetizers",
              "value": "Appetizers"
            },
            {
              "name": "Breakfast",
              "value": "Breakfast"
            },
            {
              "name": "Snacks",
              "value": "Snacks"
            },
            {
              "name": "Fancy Meal",
              "value": "Fancy Meal"
            },
            {
              "name": "Pasta",
              "value": "Pasta"
            }
          ]
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "duration",
          "label": "Cooking Time",
          "description": "Recipe pages only: total time shown on the recipe card, e.g. 25 mins"
        },
        {
          "component": "multiselect",
          "valueType": "string",
          "name": "products",
          "label": "Products",
          "description": "Recipe pages only: the YiPPee! products the recipe uses, for the Products filter",
          "options": [
            { "name": "Magic Masala Noodles", "value": "Magic Masala Noodles" },
            { "name": "Mood Masala Noodles", "value": "Mood Masala Noodles" },
            { "name": "Power Up Atta Noodles", "value": "Power Up Atta Noodles" },
            { "name": "Wow Masala Noodles", "value": "Wow Masala Noodles" },
            { "name": "Magic Millet Noodles", "value": "Magic Millet Noodles" },
            { "name": "Pasta Treat Masala", "value": "Pasta Treat Masala" },
            { "name": "Pasta Treat Tomato Cheese", "value": "Pasta Treat Tomato Cheese" },
            { "name": "Pasta Treat Cheese", "value": "Pasta Treat Cheese" },
            { "name": "Pasta Treat Sour Cream Onion", "value": "Pasta Treat Sour Cream Onion" },
            { "name": "Tricolor Pasta Creamy Corn", "value": "Tricolor Pasta Creamy Corn" },
            { "name": "Tricolor Pasta Masala", "value": "Tricolor Pasta Masala" }
          ]
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "diet",
          "label": "Diet",
          "description": "Recipe pages only: for the Diet filter",
          "options": [
            { "name": "None", "value": "" },
            { "name": "Veg", "value": "Veg" },
            { "name": "Non Veg", "value": "Non Veg" }
          ]
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "topic",
          "label": "Blog Topic",
          "description": "Blog pages only: shown on the article and its card, and offered in the blog Filters, e.g. Noodles"
        },
        {
          "component": "date-time",
          "valueType": "date-time",
          "name": "published",
          "label": "Blog Published Date",
          "description": "Blog pages only: shown on the article and its card; the blog list sorts by it"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "readtime",
          "label": "Blog Reading Time",
          "description": "Blog pages only, e.g. 5 min read"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "product",
          "label": "Product Name",
          "description": "Product pages only: the product the page is about, e.g. Magic Masala Noodles (used for search results)"
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "productcategory",
          "label": "Product Category",
          "description": "Product pages only: the range the product belongs to",
          "options": [
            { "name": "None", "value": "" },
            { "name": "Instant Noodles", "value": "Instant Noodles" },
            { "name": "Cup Noodles", "value": "Cup Noodles" },
            { "name": "Pasta", "value": "Pasta" },
            { "name": "Korean Noodles", "value": "Korean Noodles" }
          ]
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "robots",
          "label": "Search Engines",
          "description": "Hide the page from search engines (and from the site search and recipe/blog lists)",
          "options": [
            { "name": "Show in search (default)", "value": "" },
            { "name": "Hide from search", "value": "noindex" },
            { "name": "Hide from search, don't follow its links", "value": "noindex, nofollow" }
          ]
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "breadcrumb",
          "label": "Breadcrumb",
          "description": "The Home › … trail under the header",
          "options": [
            { "name": "Show (default)", "value": "" },
            { "name": "Hide", "value": "off" }
          ]
        },
        {
          "component": "aem-content",
          "valueType": "string",
          "name": "nav",
          "label": "Navigation",
          "description": "Optional: a different navigation page for this page (default: the site's nav)"
        },
        {
          "component": "aem-content",
          "valueType": "string",
          "name": "footer",
          "label": "Footer",
          "description": "Optional: a different footer page for this page (default: the site's footer)"
        }
      ]
    }
  ]
}
